<?xml version="1.0" encoding="utf-8"?>
<!--
  渲染与上下文设置。
  分组两块：渲染（性能/样式）、自动摘要（长会话上下文压缩）。
  每一行都写清楚"它是干什么的、关掉会怎样"—— 用户要求这一页能自解释。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rnd_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/rnd_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="返回"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_left"
                android:tint="#3A4353" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="渲染与上下文"
                android:textColor="#1A2230"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="6dp"
            android:lineSpacingExtra="2dp"
            android:text="这里管两件事：消息怎么画（性能），以及长会话怎么省上下文（自动摘要）。关掉任何一项都不会丢数据。"
            android:textColor="#66707F"
            android:textSize="12sp" />

        <!-- ==================== 渲染 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="渲染"
            android:textColor="#5A6B85"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 美化渲染 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="美化渲染"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="让美化正则输出的样式真正显示出来：卡片会离屏渲染成一张图，滚起来不再一顿一顿。关掉后只显示去掉标签的纯文本（最省电）。"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/rnd_html"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- 允许脚本 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="允许卡片脚本"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="只有社区美化卡需要（状态栏、进度条、模板逻辑）。默认关闭：模型输出不可信，脚本能读本地存储。开了之后卡片里的 JS 会在渲染时跑一次，画出来的结果才截成图。"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/rnd_script"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- 渲染插件入口：内置插件库，随时安装/卸载（插件本体不可删除） -->
        <LinearLayout
            android:id="@+id/rnd_plugins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="渲染插件"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="内置插件库，随时安装 / 卸载（插件本体不可删除）。用来适配预设的前端界面写法；不装任何插件时，渲染与现在完全一致。"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="#8A94A6" />
        </LinearLayout>

        <!-- 性能说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="为什么这样更顺：老做法是每条消息塞一个网页控件，滚出屏幕再滚回来就重新加载一次，内存和帧率都吃不消。现在改成「离屏画一张图 → 列表里只是图片」，同屏一个网页控件都没有。\n\n关于动态效果：列表里看到的是一张截图，所以循环动画、数字滚动这类会定格在某一帧。想看真正动起来、想选中文字，点开卡片即可 —— 那里是活的网页，脚本也会按上面的开关执行。"
            android:textColor="#66707F"
            android:textSize="12sp" />

        <!-- ==================== 自动摘要 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="自动摘要"
            android:textColor="#5A6B85"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 启用 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启用自动摘要"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="攒够条数后，把最早的一批对话压成「前情提要」。之后发消息用提要替代那几条原文，原文不删，随时能回来。"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/sum_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- 触发方式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="触发方式"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="按条数：稳定；按字数：长回复多时更省钱"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sum_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="按条数"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 阈值 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="多久触发一次"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="未摘要的内容达到这个量，就在回复结束后自动压一次"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sum_every"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="10 条"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 每次压缩几条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="每次浓缩几条"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="取最早的这么多条，不是输出几条摘要。比「多久触发」小就对了：差值那几条永远是原文，刚发生的事不会被压掉。"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sum_take"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="8 条"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 摘要字数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="摘要字数上限"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="提要最多写多长。太短会丢细节，太长又白省上下文"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sum_chars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="400 字"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 带预设 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="摘要带预设"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="把当前会话的预设完整带上（写作规则、格式要求、前置语），让摘要更懂你的口味。角色卡与世界书永远不带 —— 摘要是压缩，不是扮演。若模型拒答，可以关掉。"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/sum_preset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- 自定义提示词 -->
        <LinearLayout
            android:id="@+id/sum_prompt_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自定义摘要提示词"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="追加在系统指令后面，例如「按时间分条、保留所有数字与承诺」。留空就用内置规则。"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sum_prompt_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="未设置"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 摘要说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="摘要发到聊天右上角的「前情提要」里，可以查看、修改、清除。看模型到底收到了什么，就看那里。"
            android:textColor="#66707F"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
