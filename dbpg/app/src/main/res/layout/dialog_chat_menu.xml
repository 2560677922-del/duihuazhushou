<?xml version="1.0" encoding="utf-8"?>
<!--
  聊天界面 ⋯ 菜单容器。
  行由 NativeChatActivity.showMoreMenu() 动态插入 item_chat_menu.xml：
  分组标题 + 图标 + 主标题 + 一行说明，比原来的纯文字 AlertDialog 列表
  更容易一眼找到功能，也不会挤成一行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_menu_dialog"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="会话操作"
            android:textColor="#1A2230"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menu_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9AA4B2"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/menu_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_soft"
        android:gravity="center"
        android:padding="12dp"
        android:text="取消"
        android:textColor="#5A6B85"
        android:textSize="14sp" />
</LinearLayout>
