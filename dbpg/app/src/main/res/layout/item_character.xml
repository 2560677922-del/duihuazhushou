<?xml version="1.0" encoding="utf-8"?>
<!-- 角色卡列表项：头像 + 名字 + 副标题 + 标签。整行可点，点开看详情。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/char_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/avatar_bg"
        android:clipToOutline="true"
        android:contentDescription="角色头像"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/char_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1A2230"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/char_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#5A6B85"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/char_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#66707F"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/char_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="解析失败"
        android:textColor="#FF8A80"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
