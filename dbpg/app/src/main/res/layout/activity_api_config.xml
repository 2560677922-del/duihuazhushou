<?xml version="1.0" encoding="utf-8"?>
<!--
  原生 API 接口配置页。

  交互对齐网页版设置页：
    · 填地址 + 密钥 → 拉取模型 → 勾选多个一次加入这家；
    · 已保存的运营商可快捷切换：点开一家 → 点它的模型即「使用」，
      长按模型可删除；
    · 温度按模型保存（偶尔对某张卡微调）；
    · 单次上限 / 上下文窗口 / 历史预算 **对所有模型统一**，保存一次全生效，
      填 0 = 不限制（不发 max_tokens / 不做历史裁剪）。

  数据落在原生 ConnectionStore（生成时单向镜像给引擎）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/api_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="返回"
                android:textColor="#5A6B85"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="接口配置"
                android:textColor="#1A2230"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/api_reload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="刷新"
                android:textColor="#2F66D8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ══ 连接 ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:paddingBottom="6dp"
            android:text="连接"
            android:textColor="#8A94A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:elevation="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="请求地址（Base URL）"
                android:textColor="#5A6B85"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/api_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="https://api.example.com/v1"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#1A2230"
                android:textColorHint="#9AA4B2"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="API 密钥"
                android:textColor="#5A6B85"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="sk-…"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword"
                android:padding="12dp"
                android:textColor="#1A2230"
                android:textColorHint="#9AA4B2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/api_fetch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_accent"
                android:gravity="center"
                android:padding="13dp"
                android:text="拉取模型列表"
                android:textColor="#2F66D8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/api_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="#66707F"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ══ 运营商与模型 ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:paddingBottom="6dp"
            android:text="运营商与模型"
            android:textColor="#8A94A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/api_providers_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical" />

        <!-- ══ 生成参数 ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:paddingBottom="6dp"
            android:text="生成参数（当前模型）"
            android:textColor="#8A94A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="温度"
                        android:textColor="#5A6B85"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/api_param_temp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:padding="10dp"
                        android:textColor="#1A2230"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="单次上限（token，0=不限制）"
                        android:textColor="#5A6B85"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/api_param_max"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:padding="10dp"
                        android:textColor="#1A2230"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="上下文窗口（0=不裁剪）"
                        android:textColor="#5A6B85"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/api_param_ctx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:padding="10dp"
                        android:textColor="#1A2230"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="历史预算（token）"
                        android:textColor="#5A6B85"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/api_param_look"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:padding="10dp"
                        android:textColor="#1A2230"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="单次上限 / 上下文窗口 / 历史预算：保存时对所有模型统一生效，填 0 = 不限制；温度只影响当前模型。"
                android:textColor="#8A94A6"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/api_param_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_soft"
                android:gravity="center"
                android:padding="12dp"
                android:text="保存参数"
                android:textColor="#5A6B85"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="地址与密钥按「运营商」保存：同一家下的所有模型共用，\n改一处即全部生效（与网页版一致）。长按模型可删除。"
            android:textColor="#9AA4B2"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
