<?xml version="1.0" encoding="utf-8"?>
<!-- 原生外观设置：改完即时生效（onResume 时聊天页重新读取） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/set_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="返回"
                android:textColor="#5A6B85"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="外观设置"
                android:textColor="#1A2230"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text=" "
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 预览 -->
        <TextView
            android:id="@+id/set_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:background="#E8EEF8"
            android:padding="14dp"
            android:text="「欢迎光临……外面雨很大吧。」\n这是一段用来预览字号、行距和气泡宽度的示例文字。"
            android:textColor="#1A2230"
            android:lineSpacingMultiplier="1.4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="20dp"
            android:text="正文字号"
            android:textColor="#5A6B85"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/set_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/set_size_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="16.5 sp"
            android:textColor="#66707F"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"
            android:text="行距"
            android:textColor="#5A6B85"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/set_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/set_line_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="1.4 倍"
            android:textColor="#66707F"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"
            android:text="气泡宽度（占屏幕）"
            android:textColor="#5A6B85"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/set_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/set_width_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="86%"
            android:textColor="#66707F"
            android:textSize="12sp" />

        <!-- 字体型号：系统默认 / 无衬线 / 衬线 / 等宽 / 粗黑 -->
        <LinearLayout
            android:id="@+id/set_font_family_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="字体型号"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="无衬线 / 衬线 / 等宽 / 粗黑，全界面文字跟着换"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_font_family_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="系统默认"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 字体颜色：自动 / 墨黑 / 深灰 / 纯白 / 暖棕 / 酒红 -->
        <LinearLayout
            android:id="@+id/set_font_color_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="字体颜色"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="自动按底色取对比色；也可指定墨黑/白等"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_font_color_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="自动"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="隐藏思维链"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="原生聊天气泡里不显示 &lt;thinking&gt; / 正文前的推理段"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/set_hide_reasoning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="美化 HTML 渲染"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="正则产出的 HTML/CSS 用内嵌浏览器渲染（关掉则只显示纯文本）"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/set_html_render"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="允许美化脚本执行"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="默认关闭并剥离脚本；需要动态美化卡时再打开（有安全风险）"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/set_allow_script"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 气泡款式：点一下弹选择，改完立刻生效 -->
        <LinearLayout
            android:id="@+id/set_bubble_style_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="气泡款式"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="圆润 / 柔和 / 方角 / 极简，只影响聊天气泡外观"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_bubble_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="圆润"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 界面背景：首页/设置/资产等操作界面用；聊天背景在聊天页 ⋯ 里单独设 -->
        <LinearLayout
            android:id="@+id/set_bg_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="界面背景"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="首页 / 设置 / 资产等操作界面；图不拉伸，边缘填页面底色"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_bg_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="选择图片"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 背景遮罩：越高字越清楚、图越淡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="背景遮罩浓度"
                    android:textColor="#3A4353"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/set_bg_dim_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="55%"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/set_bg_dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:max="90" />
        </LinearLayout>

        <!--
          底板不透明度：卡片 / 按钮 / 顶栏 / 输入栏 / 弹窗的统一实心度。
          这是把"有的实心有的空心"收成一套的开关 —— 拖一下全界面一起变。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="底板不透明度"
                    android:textColor="#3A4353"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/set_panel_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="88%"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/set_panel_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:max="100" />
        </LinearLayout>

        <!-- 主题色：按钮 / 高亮 / chip 的强调色 -->
        <LinearLayout
            android:id="@+id/set_accent_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="主题色"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="按钮 / 高亮 / 导航的强调色，整体风格跟着它走"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_accent_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="默认蓝"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 页面底色：纯色背景 + 背景图没盖到的边条 -->
        <LinearLayout
            android:id="@+id/set_base_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="页面底色"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="没设背景图时的纯色；有图时填在图没盖到的边上"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_base_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="云白"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 配色风格：一次性换「底色 + 主题色」，深色皮肤的文字会自动翻白 -->
        <LinearLayout
            android:id="@+id/set_style_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="配色风格"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="整套换（底色 + 主题色）；黑金/墨蓝会把文字自动转成浅色"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_style_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="云白"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 装饰风格：樱花 / 青草，自绘不带图 -->
        <LinearLayout
            android:id="@+id/set_deco_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="装饰风格"
                    android:textColor="#1A2230"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="樱花 / 青草点缀，全部界面统一生效"
                    android:textColor="#66707F"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_deco_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_soft"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="无"
                android:textColor="#2F66D8"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/set_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:padding="14dp"
            android:text="恢复默认"
            android:textColor="#2F66D8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/set_migrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="数据迁移（网页 → 原生）"
            android:textColor="#5A6B85"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="设置只影响原生界面；预设 / 正则 / 角色卡 / 世界书 / 变量的 ST 兼容层不受影响。"
            android:textColor="#9AA4B2"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
