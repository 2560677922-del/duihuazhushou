<?xml version="1.0" encoding="utf-8"?>
<!-- 角色卡编辑：傻酒馆（SillyTavern）V2 字段表单。新建 / 编辑共用。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/edit_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="返回"
            android:textColor="#5A6B85"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="新建角色"
            android:textColor="#1A2230"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="保存"
            android:textColor="#2F66D8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- 头像（可选） -->
            <TextView
                style="@style/EditLabel"
                android:text="头像（可选）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/edit_avatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/avatar_bg"
                    android:clipToOutline="true"
                    android:contentDescription="角色头像"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/btn_pick_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:padding="8dp"
                    android:text="选择图片"
                    android:textColor="#2F66D8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_clear_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:text="清除头像"
                    android:textColor="#FF8A80"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                style="@style/EditLabel"
                android:text="名称 *" />

            <EditText
                android:id="@+id/edit_name"
                style="@style/EditInput"
                android:hint="角色名字（必填）"
                android:inputType="text" />

            <TextView
                style="@style/EditLabel"
                android:text="角色描述" />

            <EditText
                android:id="@+id/edit_description"
                style="@style/EditInputMulti"
                android:hint="外貌、身份、背景设定…" />

            <TextView
                style="@style/EditLabel"
                android:text="人格设定" />

            <EditText
                android:id="@+id/edit_personality"
                style="@style/EditInputMulti"
                android:hint="性格、说话方式、口头禅…" />

            <TextView
                style="@style/EditLabel"
                android:text="场景" />

            <EditText
                android:id="@+id/edit_scenario"
                style="@style/EditInputMulti"
                android:hint="故事发生的背景、当前处境…" />

            <TextView
                style="@style/EditLabel"
                android:text="开场白" />

            <EditText
                android:id="@+id/edit_first_mes"
                style="@style/EditInputMulti"
                android:hint="第一次说话的内容" />

            <TextView
                style="@style/EditLabel"
                android:text="对话示例" />

            <EditText
                android:id="@+id/edit_mes_example"
                style="@style/EditInputMulti"
                android:hint="示例对话，帮助模型模仿语气" />

            <TextView
                style="@style/EditLabel"
                android:text="备用开场白（每条一行）" />

            <EditText
                android:id="@+id/edit_alternate"
                style="@style/EditInputMulti"
                android:hint="写多条，换行分隔；开聊时可切换" />

            <TextView
                style="@style/EditLabel"
                android:text="标签（逗号分隔）" />

            <EditText
                android:id="@+id/edit_tags"
                style="@style/EditInput"
                android:hint="例如：助手, 猫娘, 中文" />

            <TextView
                style="@style/EditLabel"
                android:text="系统提示词" />

            <EditText
                android:id="@+id/edit_system_prompt"
                style="@style/EditInputMulti"
                android:hint="覆盖全局系统提示（一般留空）" />

            <TextView
                style="@style/EditLabel"
                android:text="历史后指令" />

            <EditText
                android:id="@+id/edit_post_history"
                style="@style/EditInputMulti"
                android:hint="写在对话历史之后的指令（一般留空）" />

            <TextView
                style="@style/EditLabel"
                android:text="创作者备注" />

            <EditText
                android:id="@+id/edit_creator_notes"
                style="@style/EditInputMulti"
                android:hint="作者想说的话" />

            <TextView
                style="@style/EditLabel"
                android:text="创作者" />

            <EditText
                android:id="@+id/edit_creator"
                style="@style/EditInput"
                android:hint="作者名" />

            <TextView
                style="@style/EditLabel"
                android:text="版本" />

            <EditText
                android:id="@+id/edit_version"
                style="@style/EditInput"
                android:hint="例如：1.0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text="保存为 SillyTavern V2 格式（.json 或带头像的 .png），可直接导回网页版或其它 ST 客户端。"
                android:textColor="#9AA4B2"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
