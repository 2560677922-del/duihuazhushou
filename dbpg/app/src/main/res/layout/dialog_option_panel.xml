<?xml version="1.0" encoding="utf-8"?>
<!--
  通用交互面板（<options>/<summary>/<comment>）的弹窗骨架。

  ★ 与 dialog_action_sheet 同原则：**不写任何颜色**，全部由
    `chat/OptionPanelSheet.kt` 按 ThemeTokens 着色。

  结构：把手 → 标题 → 可滚动内容区 → 底部（模式开关 + 关闭）。
  内容区（留言 / 选项 / 摘要）由代码动态构建，结构随消息变。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/panel_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/panel_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/panel_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp" />
    </ScrollView>

    <!-- 底部：左 = 选项点选模式（直接发送/仅填入/增量填入），右 = 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/panel_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/panel_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="13dp"
            android:paddingEnd="8dp"
            android:paddingBottom="13dp"
            android:paddingStart="16dp"
            android:text="关闭"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
