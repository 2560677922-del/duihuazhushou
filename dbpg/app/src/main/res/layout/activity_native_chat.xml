<?xml version="1.0" encoding="utf-8"?>
<!--
  原生聊天界面布局。
  要点：整屏原生渲染，不用 WebView，从根本上解决老 Android WebView
  不支持 overflow-x: clip + 美化正则注入 HTML 导致的"聊天区横向溢出"。
  消息列表用 RecyclerView：只复用可见项，长会话也顺滑、内存可控。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <!-- 顶栏：标题 + 导入 JSONL + 返回 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="原生聊天"
            android:textColor="#1A2230"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chat_engine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="引擎"
            android:textColor="#5A6B85"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chat_gen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="生图"
            android:textColor="#5A6B85"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chat_import"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="导入记录"
            android:textColor="#5A6B85"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chat_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="返回"
            android:textColor="#5A6B85"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 消息列表：RecyclerView，气泡由 ChatAdapter 原生渲染，永不横向溢出 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:scrollbars="vertical"
        android:clipToPadding="false" />

    <!-- 输入栏：原生 EditText + 发送（规避 WebView 输入框被手势条压住的坑） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:background="@android:color/transparent"
            android:textColor="#1A2230"
            android:textSize="15sp"
            android:hint="说点什么…"
            android:textColorHint="#9AA4B2"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5" />

        <TextView
            android:id="@+id/chat_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="发送"
            android:textColor="#6EA8FE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 生成中替换「发送」：同一位置，避免多塞一个按钮把输入框挤窄 -->
        <TextView
            android:id="@+id/chat_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="停止"
            android:textColor="#E06C75"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
