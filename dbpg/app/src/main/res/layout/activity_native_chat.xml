<?xml version="1.0" encoding="utf-8"?>
<!--
  原生聊天界面布局。
  要点：整屏原生渲染，不用 WebView，从根本上解决老 Android WebView
  不支持 overflow-x: clip + 美化正则注入 HTML 导致的"聊天区横向溢出"。
  消息列表用 RecyclerView：只复用可见项，长会话也顺滑、内存可控。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <!--
      顶栏：返回 + 标题（点一下改名）+ ⋯ 菜单。
      原来把「引擎/生图/导入记录」全排在上面，五个按钮挤成一排、小屏还会换行；
      收进 ⋯ 里更好点，也给标题留出改名的手势空间。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFFFF"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/chat_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="‹"
            android:textColor="#3A4353"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="冒险"
            android:textColor="#1A2230"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!--
          快捷换对话模型：点一下弹运营商，再点运营商弹该家保存的模型。
          只显示模型名（右侧▸提示可展开），不露地址/密钥；宽度封顶防挤掉标题。
        -->
        <TextView
            android:id="@+id/chat_model_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:maxWidth="150dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:background="@drawable/bg_btn_soft"
            android:text="模型"
            android:textColor="#2F66D8"
            android:textSize="12sp"
            android:contentDescription="切换对话模型" />

        <TextView
            android:id="@+id/chat_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="⋯"
            android:textColor="#3A4353"
            android:textSize="20sp"
            android:contentDescription="更多" />
    </LinearLayout>

    <!-- 消息列表：RecyclerView，气泡由 ChatAdapter 原生渲染，永不横向溢出。
         外面套 FrameLayout 是为了放「回到底部」浮动按钮。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:scrollbars="vertical"
            android:clipToPadding="false" />

        <!-- 往上翻历史后出现；点一下回到最新消息（回最低） -->
        <TextView
            android:id="@+id/chat_jump_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/bg_chip_active"
            android:text="↓ 回到最新"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            android:contentDescription="回到最新消息" />
    </FrameLayout>

    <!-- 输入栏：原生 EditText + 发送（规避 WebView 输入框被手势条压住的坑） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/bg_input_bar"
        android:gravity="center_vertical">

        <!-- 快捷生图：按「对话生图」配置出图，插到最新一条 AI 回复上 -->
        <TextView
            android:id="@+id/chat_quickimg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="🎨"
            android:textSize="18sp"
            android:contentDescription="按对话生图配置快速出图" />

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="42dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#1A2230"
            android:textSize="15sp"
            android:hint="说点什么…"
            android:textColorHint="#9AA4B2"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5" />

        <TextView
            android:id="@+id/chat_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="发送"
            android:textColor="#6EA8FE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 生成中替换「发送」：同一位置，避免多塞一个按钮把输入框挤窄 -->
        <TextView
            android:id="@+id/chat_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="停止"
            android:textColor="#E06C75"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
