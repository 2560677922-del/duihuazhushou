<?xml version="1.0" encoding="utf-8"?>
<!--
  底部导航（原生常驻）。

  分类刻意和网页版 MainLayout 的 navItems 保持一致：
    冒险 → 资产 → 设置 → 生图

  每项 = emoji 图标 + 文字（两行），当前 tab 用主题蓝高亮
  （导航只在首页常驻，首页即「冒险」，所以高亮写死即可）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_nav">

    <TextView
        android:id="@+id/nav_adventure"
        style="@style/BottomNavItem"
        android:text="🏕️\n冒险"
        android:textColor="#2F66D8" />

    <TextView
        android:id="@+id/nav_assets"
        style="@style/BottomNavItem"
        android:text="👤\n资产" />

    <TextView
        android:id="@+id/nav_settings"
        style="@style/BottomNavItem"
        android:text="⚙️\n设置" />

    <TextView
        android:id="@+id/nav_imagegen"
        style="@style/BottomNavItem"
        android:text="🎨\n生图" />
</LinearLayout>
