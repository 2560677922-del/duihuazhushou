<?xml version="1.0" encoding="utf-8"?>
<!--
  生图运营商配置页（2026-11-11 重构，与 LLM 运营商页同一套信息架构）。

  两级结构：运营商列表 → 详情（配置 / 模型）。
    · 列表态：搜索 + 头像卡片（使用中 / 模型数 / 未填密钥）+ 三点菜单 + 新建；
    · 详情态：地址与密钥收进「配置」Tab（密钥默认掩码、可显隐），
      引擎与场景绑定也在这一页；「模型」Tab 负责批量删 / 拉取添加 / 点击即用。

  换肤约定同 activity_api_config.xml：静态骨架用基准色，由 UiBackdrop 统一映射；
  运行时生成的卡片/徽章走 ProviderUi（只读 ThemeTokens）。页面不写死最终颜色。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ig_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <!-- ══════════════════ 列表态 ══════════════════ -->
    <LinearLayout
        android:id="@+id/ig_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/ig_back_list"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="返回"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_left"
                android:tint="#5A6B85" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ig_reload"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="刷新"
                android:padding="9dp"
                android:src="@drawable/ic_refresh"
                android:tint="#5A6B85" />

            <ImageView
                android:id="@+id/ig_add"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="新建运营商"
                android:padding="9dp"
                android:src="@drawable/ic_plus"
                android:tint="#2F66D8" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:text="生图运营商"
            android:textColor="#1A2230"
            android:textSize="27sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="搜索"
                android:src="@drawable/ic_search"
                android:tint="#5A6B85" />

            <EditText
                android:id="@+id/ig_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索运营商或生图模型"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#1A2230"
                android:textColorHint="#96A0B0"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ig_list_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#66707F"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ig_list_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="32dp" />
        </ScrollView>
    </LinearLayout>

    <!-- ══════════════════ 详情态 ══════════════════ -->
    <LinearLayout
        android:id="@+id/ig_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ig_back_detail"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="返回列表"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_left"
                android:tint="#5A6B85" />

            <TextView
                android:id="@+id/ig_detail_avatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:text=""
                android:textColor="#2F66D8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ig_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="#1A2230"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ig_detail_more"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="更多操作"
                android:padding="7dp"
                android:src="@drawable/ic_more_vert"
                android:tint="#5A6B85" />
        </LinearLayout>

        <TextView
            android:id="@+id/ig_detail_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="4dp"
            android:text=""
            android:textColor="#66707F"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/ig_tab_config"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_accent"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="配置"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ig_tab_models"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_soft"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="模型"
                android:textColor="#5A6B85"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ── 配置 Tab ── -->
            <ScrollView
                android:id="@+id/ig_pane_config"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/PvFieldLabel"
                            android:text="名称" />

                        <EditText
                            android:id="@+id/ig_cfg_name"
                            style="@style/PvFieldInput"
                            android:hint="给这家起个名字"
                            android:inputType="text" />

                        <TextView
                            style="@style/PvFieldLabel"
                            android:text="API Key" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/ig_cfg_key"
                                style="@style/PvFieldInput"
                                android:hint="sk-…"
                                android:inputType="textPassword"
                                android:paddingEnd="46dp" />

                            <ImageView
                                android:id="@+id/ig_cfg_key_eye"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="13dp"
                                android:contentDescription="显示或隐藏密钥"
                                android:src="@drawable/ic_eye"
                                android:tint="#5A6B85" />
                        </FrameLayout>

                        <TextView
                            style="@style/PvFieldLabel"
                            android:text="API Base Url" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/ig_cfg_base"
                                style="@style/PvFieldInput"
                                android:hint="https://api.example.com/v1"
                                android:inputType="textUri"
                                android:paddingEnd="46dp" />

                            <ImageView
                                android:id="@+id/ig_cfg_refetch"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="13dp"
                                android:contentDescription="用这个地址重新拉取模型"
                                android:src="@drawable/ic_refresh"
                                android:tint="#2F66D8" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="渲染引擎"
                            android:textColor="#1A2230"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/ig_cfg_engine_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingMultiplier="1.3"
                            android:text="地址会自动尝试 /ai/generate-image 与 /v1/images/generations，一般不用手填路径"
                            android:textColor="#8A94A6"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/ig_cfg_engines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="使用场景"
                            android:textColor="#1A2230"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="对话配图与标签生图各记各的，互不影响"
                            android:textColor="#8A94A6"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/ig_cfg_scenes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="概览"
                            android:textColor="#8A94A6"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ig_cfg_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingMultiplier="1.35"
                            android:text=""
                            android:textColor="#5A6B85"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ── 模型 Tab ── -->
            <LinearLayout
                android:id="@+id/ig_pane_models"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/ig_model_batch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_soft"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="☐ 批量删除模型"
                        android:textColor="#2F66D8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/ig_model_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#8A94A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/ig_model_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="24dp" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/ig_float_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_soft"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:text="删除运营商"
                android:textColor="#5A6B85"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/ig_float_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:text="保存"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
