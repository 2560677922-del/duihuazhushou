<?xml version="1.0" encoding="utf-8"?>
<!--
  对话生图配置（原生）。
  与标签生图区分开：这里管的是"聊天时快捷出图/自动配图"用什么配置：
  上文条数、是否用模型生成提示词（用哪个模型）、哪家运营商、哪套风格、采样参数。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/cimg_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="返回"
                android:textColor="#5A6B85"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="对话生图"
                android:textColor="#1A2230"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cimg_reload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="刷新"
                android:textColor="#2F66D8"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:paddingBottom="6dp"
            android:text="提示词来源"
            android:textColor="#8A94A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="带多少条上文"
                    android:textColor="#1A2230"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/cimg_ctx_minus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_soft"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="−"
                    android:textColor="#2F66D8"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cimg_ctx_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="54dp"
                    android:gravity="center"
                    android:text="5 条"
                    android:textColor="#1A2230"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cimg_ctx_plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_soft"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="＋"
                    android:textColor="#2F66D8"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="用模型生成画面标签"
                        android:textColor="#1A2230"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="打开后用对话模型把上文转成英文标签（更准，更慢）"
                        android:textColor="#8A94A6"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/cimg_use_llm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/cimg_llm_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:padding="11dp"
                android:text="提示词模型：跟随当前模型"
                android:textColor="#1A2230"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp"
            android:text="出图配置"
            android:textColor="#8A94A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/cimg_api_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="11dp"
                android:text="运营商 · 模型：读取中…"
                android:textColor="#1A2230"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/cimg_engine_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:padding="11dp"
                android:text="渲染器：读取中…"
                android:textColor="#1A2230"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="图片大小（与标签生图共用）"
                android:textColor="#1A2230"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 三列网格一次铺开，不用横滑找 1216x832 -->
            <LinearLayout
                android:id="@+id/cimg_size_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/cimg_style_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="11dp"
                android:text="风格：读取中…"
                android:textColor="#1A2230"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/cimg_steps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="步数"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textColor="#1A2230"
                    android:textColorHint="#9AA4B2"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/cimg_cfg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="CFG"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="10dp"
                    android:textColor="#1A2230"
                    android:textColorHint="#9AA4B2"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/cimg_sampler_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="11dp"
                android:text="采样器：k_euler_ancestral"
                android:textColor="#1A2230"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cimg_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_accent"
            android:gravity="center"
            android:padding="13dp"
            android:text="保存"
            android:textColor="#2F66D8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="聊天输入栏左侧的 🎨 按钮按这套配置快速出图。"
            android:textColor="#9AA4B2"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
