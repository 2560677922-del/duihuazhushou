<?xml version="1.0" encoding="utf-8"?>
<!-- 数据迁移页：把网页（IndexedDB）里的会话/角色/图片搬到原生存储 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/mig_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="返回"
            android:textColor="#8FA6C8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="数据迁移"
            android:textColor="#E6EAF2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text=""
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="把网页版里的会话、角色卡、图片复制一份到原生存储。"
                android:textColor="#C8D3E6"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="· 只读导出，不会删除或修改网页里的原数据\n· 重复执行不会产生重复会话（同 id 会跳过）\n· 聊天记录里的图片会单独搬运，缺图会如实告诉你"
                android:textColor="#7E8CA6"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mig_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#161A22"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="尚未开始"
                android:textColor="#E6EAF2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mig_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#2A4B7C"
                android:gravity="center"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:text="开始迁移"
                android:textColor="#EAF1FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text="说明：迁移只是「把数据搬过来」，现在还不影响网页版的使用。等原生界面接管后，网页版里的旧数据可以作为备份保留，也可以手动清掉。"
                android:textColor="#6C7994"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
