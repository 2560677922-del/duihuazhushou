<?xml version="1.0" encoding="utf-8"?>
<!--
  原生「标签生图」页。

  2026-11-07 重构：地址 / 密钥 / 模型三个裸输入框全部撤掉。
  用户已经在「生图运营商」里配好了「砂糖」这类中转，出图时只需要
  「选哪家 → 选哪个模型 → 选渲染器 → 选尺寸」，把连接细节藏在内部，
  界面上不该再出现一长串 URL 和 sk-。

  这里的选择与「对话生图」（聊天里的 🎨）互相独立：切换运营商/模型只写
  sceneApiIds.tag，不会把聊天那套带着改掉。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#FFFFFFFF"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="标签生图"
            android:textColor="#1A2230"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gen_config"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="运营商"
            android:textColor="#2F66D8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/gen_gallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="图片库"
            android:textColor="#2F66D8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/gen_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="关闭"
            android:textColor="#5A6B85"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 出图配置卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="出图配置 · 仅用于标签生图"
                    android:textColor="#8A94A6"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gen_api_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:padding="11dp"
                    android:text="运营商 · 模型：读取中…"
                    android:textColor="#1A2230"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/gen_engine_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:padding="11dp"
                    android:text="渲染器：读取中…"
                    android:textColor="#1A2230"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/gen_style_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:padding="11dp"
                    android:text="风格：读取中…"
                    android:textColor="#1A2230"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- 尺寸快捷档位：只给小图，省额度也出得快 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="图片大小"
                        android:textColor="#1A2230"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/gen_size_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="832 × 1216"
                        android:textColor="#2F66D8"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 三列网格一次铺开，不用横滑找 1216x832 -->
                <LinearLayout
                    android:id="@+id/gen_size_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="只列小图档位；点一下即时生效，风格页与这里共用同一尺寸。"
                    android:textColor="#9AA4B2"
                    android:textSize="10sp" />

                <!-- 采样参数：NovelAI / 本地部署会真正带进请求体 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/gen_steps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="步数"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:padding="10dp"
                        android:textColor="#1A2230"
                        android:textColorHint="#9AA4B2"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/gen_cfg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="CFG"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:padding="10dp"
                        android:textColor="#1A2230"
                        android:textColorHint="#9AA4B2"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gen_sampler_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:padding="11dp"
                    android:text="采样器：k_euler_ancestral"
                    android:textColor="#1A2230"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <EditText
                android:id="@+id/gen_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minLines="3"
                android:gravity="top|start"
                android:hint="标签 / 提示词"
                android:textColorHint="#9AA4B2"
                android:textColor="#1A2230"
                android:textSize="14sp"
                android:inputType="textMultiLine|textCapSentences"
                android:background="@drawable/bg_input"
                android:padding="12dp" />

            <!--
              已选标签：中文展示、可单个移除，实际发给生图模型的只有英文 tag。
              放在生成按钮上方，用户一眼能确认自己选了什么。
            -->
            <LinearLayout
                android:id="@+id/gen_selected_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!--
              出图参考图：发给生图模型的那张（NAI 参考图 / Vibe Transfer），
              用来锁人物形象。与风格页的"风格参考图"（只给人看）是两回事，
              所以单独放这里，出图前随手换、随手调参。
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="出图参考图（发给模型 · 锁人物形象）"
                        android:textColor="#3A4353"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/gen_ref_pick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_soft"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="换图"
                        android:textColor="#2F66D8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/gen_ref_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_btn_soft"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="清除"
                        android:textColor="#8A94A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gen_ref_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="未设置 · 设置后生图会带上这张参考"
                    android:textColor="#8A94A6"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/gen_ref_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_soft"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="出图参考图" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/gen_ref_strength_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="参考强度 0.60"
                        android:textColor="#3A4353"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/gen_ref_strength"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/gen_ref_info_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="信息提取 0.70"
                        android:textColor="#3A4353"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/gen_ref_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100" />
                </LinearLayout>
            </LinearLayout>

            <!--
              生成与结果放在标签列表「之前」。标签库能展开/加载更多之后，
              列表可能很长；放末尾会把按钮和出图结果顶到屏幕外，用户点了生成
              却看不到图。现在结果区固定在上半段，标签怎么展开都不影响。
            -->
            <TextView
                android:id="@+id/gen_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="生成"
                android:background="@drawable/bg_btn_accent"
                android:textColor="#2F66D8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gen_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#5A6B85"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/gen_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 标签一级 / 二级分类（与网页 Tags 页一致） -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/gen_group_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/gen_sub_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/gen_tag_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="搜索标签（点结果追加到提示词）"
                android:textColorHint="#9AA4B2"
                android:textColor="#1A2230"
                android:textSize="13sp"
                android:inputType="text"
                android:importantForAutofill="no"
                android:background="@drawable/bg_input"
                android:padding="12dp" />

            <TextView
                android:id="@+id/gen_tag_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text=""
                android:textColor="#9AA4B2"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/gen_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
