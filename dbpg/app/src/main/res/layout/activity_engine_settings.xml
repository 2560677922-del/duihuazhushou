<?xml version="1.0" encoding="utf-8"?>
<!-- 引擎设置：只负责「启用哪个」，预设/世界书的内容仍在 ST 兼容层 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1115">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/engine_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="返回"
            android:textColor="#8FA6C8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="引擎设置"
            android:textColor="#E6EAF2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/engine_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="重载"
            android:textColor="#7FB2FF"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:lineSpacingExtra="4dp"
        android:text="这里只切「用哪个」。预设、世界书、正则的内容仍然以 SillyTavern 兼容格式存在引擎侧，原生不复制一份。"
        android:textColor="#6C7A90"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/engine_preset_title"
                style="@style/DetailSectionTitle" />

            <LinearLayout
                android:id="@+id/engine_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/engine_char_title"
                style="@style/DetailSectionTitle" />

            <LinearLayout
                android:id="@+id/engine_characters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/engine_wb_title"
                style="@style/DetailSectionTitle" />

            <LinearLayout
                android:id="@+id/engine_worldbooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/engine_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:lineSpacingExtra="4dp"
                android:text="正在读取引擎资产…"
                android:textColor="#6C7A90"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
