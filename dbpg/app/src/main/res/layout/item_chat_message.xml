<?xml version="1.0" encoding="utf-8"?>
<!--
  单条消息气泡。user 靠右、assistant 靠左，靠容器 gravity 切换。
  文本用 TextView 原生渲染，图片用 ImageView 原生加载 —— 不再依赖 WebView。

  底部一行是「版本 ‹ 2/3 › + ⋯ 操作」：
    · 只有一个版本时整行隐藏（不占位、不绘制）；
    · ⋯ 只在会话消息上出现，jsonl 预览这类只读内容没有操作。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="280dp"
        android:padding="10dp"
        android:background="@drawable/bubble_bg">

        <!--
          美化卡片：显示离屏渲染好的位图（不是 WebView）。
          ★ 以前这里是 <WebView>，每个 ViewHolder 都会实例化一个完整渲染上下文，
            同屏 10 个就是 10 个 WebView —— 滚动掉帧、内存飙高的主因。
            现在列表里零 WebView；需要真网页交互时点开全屏「卡片查看器」。
        -->
        <ImageView
            android:id="@+id/msg_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/msg_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A2230"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

        <!-- 图片容器：原生聊天里最占地方的就是配图，单独一列堆叠 -->
        <LinearLayout
            android:id="@+id/msg_images"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

        <!-- 底部元信息：版本切换 + 操作入口 -->
        <LinearLayout
            android:id="@+id/msg_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/msg_ver_older"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="‹"
                android:textColor="#7F8DA6"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/msg_ver_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="26dp"
                android:gravity="center"
                android:textColor="#7F8DA6"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/msg_ver_newer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="›"
                android:textColor="#7F8DA6"
                android:textSize="15sp" />

            <!-- 单条消息生图：点它把这条 + 前 N 条当上下文出图，图挂回这条消息 -->
            <TextView
                android:id="@+id/msg_img_gen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="生图"
                android:textColor="#7F8DA6"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/msg_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="⋯ 操作"
                android:textColor="#7F8DA6"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
