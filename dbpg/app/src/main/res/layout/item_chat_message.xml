<?xml version="1.0" encoding="utf-8"?>
<!--
  单条消息气泡。user 靠右、assistant 靠左，靠容器 gravity 切换。
  文本用 TextView 原生渲染，图片用 ImageView 原生加载 —— 不再依赖 WebView。

  底部一行是「版本 ‹ 2/3 › + ⋯ 操作」：
    · 只有一个版本时整行隐藏（不占位、不绘制）；
    · ⋯ 只在会话消息上出现，jsonl 预览这类只读内容没有操作。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 群聊头像：只有 AI 消息且知道角色名时显示；用户消息不显示 -->
    <ImageView
        android:id="@+id/msg_avatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="start|top"
        android:layout_marginTop="2dp"
        android:background="@drawable/avatar_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="280dp"
        android:padding="10dp"
        android:background="@drawable/bubble_bg">

        <!-- 群聊公共区：发言人名字（私聊/单人为空，整行不占位） -->
        <TextView
            android:id="@+id/msg_speaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:textColor="#2F66D8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!--
          富文本容器：装一个 HtmlMessageView（WebView）。

          ★ 只有「含标记的消息」才会走到这里（纯文本仍用下面的 TextView）。
            纯文本消息占绝对多数，所以列表里的 WebView 实例数被压得很低；
            Adapter 还限制了这类 ViewHolder 的回收池大小（见 MAX_WEB_POOL）。
          为什么不用位图：位图是静态的 —— <details> 点不开、链接点不了，
          每张还要离屏绘制 + 落盘。真渲染只有 WebView 做得到。
        -->
        <FrameLayout
            android:id="@+id/msg_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- 位图卡片：旧路径的降级位（WebView 不可用/内容超限时才用） -->
        <ImageView
            android:id="@+id/msg_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/msg_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A2230"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

        <!--
          分块渲染容器（目前只用于 <details> 折叠栏）。
          含折叠块的消息不能用单个 TextView：折叠状态要能点开/收起，
          所以这里按块放「文本 TextView + 折叠卡片」。
        -->
        <LinearLayout
            android:id="@+id/msg_blocks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- 图片容器：原生聊天里最占地方的就是配图，单独一列堆叠 -->
        <LinearLayout
            android:id="@+id/msg_images"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

        <!-- 底部元信息：版本切换 + 操作入口 -->
        <LinearLayout
            android:id="@+id/msg_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/msg_ver_older"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="‹"
                android:textColor="#7F8DA6"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/msg_ver_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="26dp"
                android:gravity="center"
                android:textColor="#7F8DA6"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/msg_ver_newer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="›"
                android:textColor="#7F8DA6"
                android:textSize="15sp" />

            <!-- 单条消息生图：点它把这条 + 前 N 条当上下文出图，图挂回这条消息 -->
            <TextView
                android:id="@+id/msg_img_gen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="生图"
                android:textColor="#7F8DA6"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/msg_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="⋯ 操作"
                android:textColor="#7F8DA6"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
