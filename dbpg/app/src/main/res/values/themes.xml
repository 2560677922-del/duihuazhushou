<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      刻意用系统自带主题，不引入 androidx / material 依赖：
      这样 Gradle 同步只需要下载 AGP，缺依赖导致的失败面最小。
    -->
    <style name="Theme.DHP" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:colorBackground">@color/app_bg</item>
    </style>

    <!--
      页面加载完之后切换到这个主题：windowBackground 恢复成纯色。
      否则启动图会一直铺在 WebView 底下 —— 界面滚动到边缘时会露出来。
    -->
    <style name="Theme.DHP.Content" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:colorBackground">@color/app_bg</item>
    </style>

    <!-- 底部导航项容器：等分、垂直居中（上图标下文字） -->
    <style name="BottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <!-- 底部导航文字：比图标小一号，和图标间留一点呼吸 -->
    <style name="BottomNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#5A6B85</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <!-- 资产页分类 tab（pill 样式） -->
    <style name="AssetsTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:textColor">#5A6B85</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 详情页分段标题 -->
    <style name="DetailSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:textColor">#5A6B85</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 详情页分段正文：可选中的正文，行距略松 -->
    <style name="DetailSectionBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:textColor">#D6DCE8</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- 编辑器标签 -->
    <style name="EditLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">#5A6B85</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 编辑器单行输入 -->
    <style name="EditInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">#1A2230</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 编辑器多行输入 -->
    <style name="EditInputMulti">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:gravity">start|top</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#1A2230</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
        <item name="android:scrollbars">vertical</item>
    </style>
</resources>
