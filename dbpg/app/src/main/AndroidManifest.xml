<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AI 接口 / 素材下载都要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 只有 Android 9 及以下「保存到相册」才需要；Android 10+ 走 MediaStore 免权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 图片本身写在 App 私有目录（免权限）；仅「保存到相册」在 Android 9 及以下需要写权限 -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DHP"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 原生聊天界面：由网页桥 AndroidNative.openNativeChat 拉起，不对外暴露 -->
        <activity
            android:name=".NativeChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP" />

        <!-- 原生「标签生图」试验页：纯 Kotlin 生图管线（OkHttp + ZIP 解压 + 落盘） -->
        <activity
            android:name=".NativeImageGenActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP" />

        <!-- 原生角色卡库：扫描/导入 ST 的 .png/.json 卡，点击后交回网页建档 -->
        <activity
            android:name=".character.CharacterListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 角色卡详情（全屏）：分段展示设定，可翻备用开场白 -->
        <activity
            android:name=".character.CharacterDetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 一次性数据迁移：把网页 IndexedDB 里的会话/角色/图片复制到原生存储 -->
        <activity
            android:name=".data.MigrationActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 原生外观设置：字号/行距/气泡宽度/隐藏思维链 -->
        <activity
            android:name=".appearance.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />
        <!-- 原生会话列表：底部「聊天」tab 落地页，点一条切会话并进原生聊天 -->
        <activity
            android:name=".session.SessionListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 原生图片库：生成图 + 聊天图，网格预览、全屏查看、保存相册 -->
        <activity
            android:name=".gallery.GalleryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 引擎设置：只切「启用哪个」预设/角色/世界书，内容仍在 ST 兼容层 -->
        <activity
            android:name=".engine.EngineSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <activity
            android:name=".gallery.ImageViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />
    </application>

</manifest>
