<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AI 接口 / 素材下载都要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 只有 Android 9 及以下「保存到相册」才需要；Android 10+ 走 MediaStore 免权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 图片本身写在 App 私有目录（免权限）；仅「保存到相册」在 Android 9 及以下需要写权限 -->

    <application
        android:name=".DhpApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DHP"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 原生聊天界面：由网页桥 AndroidNative.openNativeChat 拉起，不对外暴露 -->
        <activity
            android:name=".NativeChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP" />

        <!-- 卡片查看器：列表里是位图，进这里才是真 WebView（可选中/可脚本） -->
        <activity
            android:name=".chat.render.CardViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP" />

        <!-- 原生「标签生图」试验页：纯 Kotlin 生图管线（OkHttp + ZIP 解压 + 落盘） -->
        <activity
            android:name=".NativeImageGenActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP" />

        <!-- 原生角色卡库：扫描/导入 ST 的 .png/.json 卡，点击后交回网页建档 -->
        <activity
            android:name=".character.CharacterListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 角色卡详情（全屏）：分段展示设定，可翻备用开场白 -->
        <activity
            android:name=".character.CharacterDetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 一次性数据迁移：把网页 IndexedDB 里的会话/角色/图片复制到原生存储 -->
        <activity
            android:name=".data.MigrationActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 原生外观设置：字号/行距/气泡宽度/隐藏思维链 -->
        <activity
            android:name=".appearance.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />
        <!-- 渲染与上下文：美化渲染 / 卡片脚本 / 自动摘要 -->
        <activity
            android:name=".appearance.RenderSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />
        <!-- 渲染插件设置：内置插件库，随时安装/卸载（插件本体不可删除） -->
        <activity
            android:name=".settings.PluginSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />
        <!-- 原生会话列表：底部「聊天」tab 落地页，点一条切会话并进原生聊天 -->
        <activity
            android:name=".session.SessionListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 原生图片库：生成图 + 聊天图，网格预览、全屏查看、保存相册 -->
        <activity
            android:name=".gallery.GalleryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 图片全屏查看：生成图 / 聊天图共用 -->
        <activity
            android:name=".gallery.ImageViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 设置首页：接口配置 / 外观 / 引擎 / 图片库 / 迁移 的入口列表 -->
        <activity
            android:name=".settings.SettingsHomeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- API 接口配置：地址 + 密钥 + 拉取模型（数据落在 web apiConfig store，同源） -->
        <activity
            android:name=".settings.ApiConfigActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 资产页：角色/预设/世界书/正则 + 快捷切换 + 导入导出（对齐网页版资产页） -->
        <activity
            android:name=".assets.AssetsHomeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 生图风格：画师串/质量串/负面/模板/尺寸（数据落在 web image store） -->
        <activity
            android:name=".settings.ImageStyleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 对话生图：上文条数/提示词模型/运营商与风格/采样参数 -->
        <activity
            android:name=".settings.ChatImageConfigActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 显示设置：思维链隐藏 / 发给后端带不带正则 / 导出原文 -->
        <activity
            android:name=".settings.DisplayActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />

        <!-- 生图接口配置：交互对齐 LLM 运营商（数据落在 web image store） -->
        <activity
            android:name=".imagegen.ImageGenConfigActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DHP.Content" />
    </application>

</manifest>
